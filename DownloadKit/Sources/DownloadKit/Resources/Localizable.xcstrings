        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu indirme için kaydedilen çerezler veya kimlik bilgileri okunamadı (anahtarlık kilitli olabilir ya da kayıt kaldırılmış olabilir). İndirmeyi kaldırıp yeniden ekleyin."
          }
        }
      }
    },
